# Server Port (default: 8000)
PORT=8000

# Client origin for CORS (default: http://localhost:5173)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/interviewiq?retryWrites=true&w=majority
MONGODB_URL=

# JWT Secret for cookie authentication
JWT_SECRET=your_jwt_secret_key_here

# OpenRouter API Key for AI resume parsing, question generation & evaluation
# Get your key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Razorpay API Credentials (for credits payment)
# Get keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
