# Firebase Web API Key for Google Sign-In authentication
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> apiKey
VITE_FIREBASE_APIKEY=

# Razorpay Key ID (Public key for client-side checkout modal)
# Must match RAZORPAY_KEY_ID from server
VITE_RAZORPAY_KEY_ID=

# Backend Server URL (default: http://localhost:8000)
VITE_SERVER_URL=http://localhost:8000
